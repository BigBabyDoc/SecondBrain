// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DOCTOR
  ADMIN
}

/// Порядок важен: индекс тарифа используется для проверки доступа (PAID >= FREE)
enum Tier {
  FREE
  PAID
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(DOCTOR)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription       Subscription?
  payments           Payment[]
  notes              Note[]                   @relation("NoteAuthor")
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
}

/// Токены одноразовые: хранится только SHA-256 хеш, сам токен уходит пользователю в письме.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Неудачные попытки входа для защиты от подбора пароля.
/// identifier — нормализованный email или IP-адрес.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               Tier               @default(FREE)
  period             BillingPeriod?
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd   DateTime?
  yookassaMethodId   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            Tier
  period          BillingPeriod
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("RUB")
  status          PaymentStatus @default(PENDING)
  yookassaPaymentId String      @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  tier      Tier     @default(FREE)
  tags      String[] @default([])
  published Boolean  @default(true)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
  @@index([published])
}
