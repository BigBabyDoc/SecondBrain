// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DOCTOR
  ADMIN
}

/// Порядок важен: индекс тарифа используется для проверки доступа (PAID >= FREE)
enum Tier {
  FREE
  PAID
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

/// Кто инициировал платёж. Разделение нужно и для отчётности, и для вебхука:
/// у автосписания нет подтверждения от пользователя, оно приходит сразу succeeded.
enum PaymentKind {
  /// Оплата, начатая пользователем на сайте
  INITIAL
  /// Автосписание по сохранённому платёжному средству (раздел 8 оферты)
  RENEWAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(DOCTOR)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription       Subscription?
  payments           Payment[]
  notes              Note[]                   @relation("NoteAuthor")
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  media              MediaObject[]            @relation("MediaUploader")
  consents           Consent[]
}

enum ConsentType {
  /// Ознакомление с Пользовательским соглашением и Публичной офертой
  TERMS
  /// Согласие № 1 — на обработку персональных данных
  PERSONAL_DATA
  /// Подтверждение статуса медработника и возраста 18+
  PROFESSIONAL_STATUS
  /// Согласие № 4 — на информационные и рекламные сообщения
  MARKETING
  /// Согласие № 2 — на автопродление. Не используется, пока автосписание не запущено.
  AUTO_RENEWAL
}

/// Журнал согласий: закон требует подтверждать факт, дату, время и версию
/// документа при предоставлении и отзыве каждого согласия.
model Consent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  /// Версия документа, с которой согласился пользователь
  version   String
  grantedAt DateTime    @default(now())
  grantedIp String?
  revokedAt DateTime?
  revokedIp String?

  @@index([userId, type])
}

/// Токены одноразовые: хранится только SHA-256 хеш, сам токен уходит пользователю в письме.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Неудачные попытки входа для защиты от подбора пароля.
/// identifier — нормализованный email или IP-адрес.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               Tier               @default(FREE)
  period             BillingPeriod?
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd   DateTime?
  yookassaMethodId   String?
  /// Последние 4 цифры привязанной карты и её платёжная система. Согласие № 2
  /// обещает показывать, чем именно будут списывать, — без этого «привязанная
  /// карта» остаётся для человека абстракцией. Полный номер не хранится и
  /// Оператору не передаётся: он остаётся у платёжного сервиса.
  cardLast4          String?
  cardNetwork        String?
  /// Единственный признак, по которому задача продления решает списывать или нет.
  /// По п. 8.1.2 оферты оплата без привязки средства обязана быть возможна,
  /// поэтому «оплатил без автопродления» и «отключил автопродление» — это одно
  /// состояние (false), а не два разных статуса.
  autoRenew          Boolean            @default(false)
  /// Стоимость, о которой пользователь был уведомлён при подключении.
  /// По п. 8.3.2 при её росте списание приостанавливается до подтверждения.
  renewalAmount      Decimal?           @db.Decimal(10, 2)
  /// Неудачные попытки списания в текущем цикле: по п. 8.2.4 их не больше трёх.
  renewalAttempts    Int                @default(0)
  /// Когда ушло уведомление о предстоящем списании — чтобы не слать его дважды
  /// (п. 8.2.2 требует одного предупреждения не позднее чем за 3 дня).
  renewalNoticeSentAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            Tier
  period          BillingPeriod
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("RUB")
  status          PaymentStatus @default(PENDING)
  kind            PaymentKind   @default(INITIAL)
  yookassaPaymentId String      @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}

/// Загруженные файлы адресуются по содержимому: ключ хранения — sha256 байтов,
/// поэтому повторная загрузка того же файла не создаёт дубликат.
/// Сами байты лежат в S3 или в локальной папке — см. lib/storage.ts.
model MediaObject {
  id           String   @id @default(cuid())
  checksum     String   @unique
  contentType  String
  sizeBytes    Int
  storageKey   String
  originalName String
  uploadedById String
  uploadedBy   User     @relation("MediaUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
}

model Note {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  tier      Tier     @default(FREE)
  tags      String[] @default([])
  published Boolean  @default(true)
  /// Счётчик открытий заметки. Инкремент шлёт браузер один раз за сессию
  /// (components/view-counter.tsx): рендер на сервере повторяется при
  /// префетче и перепроверке, и счётчик от этого раздувался бы.
  views     Int      @default(0)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
  @@index([published])
}
