# Скопируйте этот файл в .env и заполните значениями

# Строка подключения к PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secondbrain?schema=public"

# NextAuth — сгенерируйте случайную строку: `openssl rand -base64 32`
AUTH_SECRET="change-me"
# Публичный адрес сайта: используется в ссылках из писем, sitemap и return_url ЮKassa
NEXTAUTH_URL="http://localhost:3000"

# ЮKassa — shopId и секретный ключ из личного кабинета ЮKassa (Настройки -> API)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# SMTP для писем (подтверждение email, сброс пароля, уведомления).
# Если не заполнено — письма не отправляются, а печатаются в консоль сервера.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Адрес в поле «От кого». Должен совпадать с ящиком, под которым идёт авторизация в SMTP,
# иначе почтовые провайдеры отклонят письмо.
MAIL_FROM="Second_Brain_Pediatra@mail.ru"

# Хранилище файлов заметок (Yandex Object Storage или другое S3-совместимое).
# Если ключи не заданы, файлы пишутся в локальную папку MEDIA_LOCAL_DIR —
# так работает разработка без облака.
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
MEDIA_LOCAL_DIR=".media"

# Секрет для служебного эндпоинта /api/cron/subscriptions.
# Планировщик должен слать заголовок: Authorization: Bearer <значение>
CRON_SECRET=""

# Sentry (необязательно). Без DSN мониторинг не активируется.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
